# Copy to .env.local and fill in. NEVER commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox → account.mapbox.com → Access tokens (public token)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Anthropic → console.anthropic.com → API keys (server-side only)
ANTHROPIC_API_KEY=

# Optional: Meta app token for Instagram oEmbed ("APP_ID|CLIENT_TOKEN").
# Requires a Meta developer app with the oEmbed Read feature approved.
# Skip freely — the caption-paste import path works without it.
META_OEMBED_TOKEN=

# Optional: canonical site URL (e.g. https://spots.vercel.app). Used as the
# auth-callback redirect base instead of the request Host header.
NEXT_PUBLIC_SITE_URL=
